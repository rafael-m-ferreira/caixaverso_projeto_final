        "#Filtrando e agrupando\n",
        "df_valores_de_viagens_agrupados_por_orgao = df_viagem[['Nome do órgão superior', 'Valor diárias', 'Valor passagens', 'Valor outros gastos', 'Gasto total']].groupby([\"Nome do órgão superior\"]).sum()\n",
